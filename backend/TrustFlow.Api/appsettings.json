{
  "Jwt": {
    "Issuer": "TrustFlow.Api",
    "Audience": "TrustFlow.Web",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "MalwareScanner": {
    "Host": "127.0.0.1",
    "Port": 3310,
    "TimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
